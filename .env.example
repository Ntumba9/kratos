# KRATOS - Docker Compose environment
# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
#
# Generate strong values with e.g.:  openssl rand -base64 32

# PostgreSQL superuser (used only by the postgres container bootstrap)
KRATOS_POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Schema owner role - runs migrations only
KRATOS_DB_OWNER_PASSWORD=CHANGE_ME
# Least-privilege application role - used by php-fpm and workers
KRATOS_DB_APP_PASSWORD=CHANGE_ME
# Redis AUTH password
KRATOS_REDIS_PASSWORD=CHANGE_ME
# Shared secret CORE uses to sign requests to KRATOS MIND (>= 32 characters)
KRATOS_MIND_SHARED_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS

# Host ports (bound to 127.0.0.1)
KRATOS_HTTP_PORT=8080
KRATOS_MAILPIT_PORT=8025
KRATOS_POSTGRES_PORT=55432
KRATOS_REDIS_PORT=56379

# Seed clearly-labelled synthetic demonstration accounts on startup
KRATOS_DEMO_MODE=false
